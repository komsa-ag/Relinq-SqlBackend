<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{EBA04D26-8D5B-4EF5-9898-C2D90373149C}</ProjectGuid>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>NET_4_0</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>..\..\Relinq\Binaries\$(Configuration)\</OutputPath>
    <Deterministic>true</Deterministic>
    <NoWarn>1591;419</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="AssemblyInfo">
    <Title>re-linq SQL Backend</Title>
    <Description>re-linq SQL Backend: A framework for generating SQL based on the re-linq Frontend.</Description>
    <PackageProjectUrl>https://github.com/komsa-ag/Relinq-SqlBackend</PackageProjectUrl>
    <RepositoryUrl>https://github.com/komsa-ag/Relinq-SqlBackend</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Erzeugt ein entsprechendes *.nupkg im Ausgabe-Verzeichnis -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Metadaten für das Package -->
    <PackageId>Komsa.Remotion.Linq.SqlBackend</PackageId>
    <Description>re-linq SQL Backend</Description>
    <PackageTags>Remotion Linq Relinq Sql</PackageTags>
    <VersionPrefix>$(RelinqPackageVersion)</VersionPrefix>
    <Authors>rubicon IT GmbH; KOMSA AG</Authors>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Damit das Package eine "Run/Output-Dependency" des Projektes wird, indem es installiert wird -->
    <DevelopmentDependency>false</DevelopmentDependency>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="..\..\Relinq\AssemblyInfoShared.cs" Link="AssemblyInfoShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Build\NuSpec\TemplateShared.nuspec">
      <Link>TemplateShared.nuspec</Link>
    </None>
    <None Include="..\Directory.Build.props" Link="Directory.Build.props" />
    <None Include="..\LGPL.licenseheader">
      <Link>LGPL.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Relinq\Core.Net_4_5\Remotion.Linq.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="$(MicrosoftSourceLinkGitHubPackageVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <Target Name="IncludePdbInPackage" AfterTargets="Build">
    <ItemGroup>
      <None Include="$(OutputPath)\$(AssemblyName).pdb" Pack="true" PackagePath="lib\$(TargetFramework)" />
    </ItemGroup>
  </Target>
</Project>