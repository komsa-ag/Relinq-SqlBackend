<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
  </PropertyGroup>
  <PropertyGroup>
    <ProjectGuid>{EBA04D26-8D5B-4EF5-9898-C2D90373149C}</ProjectGuid>
    <TargetFrameworks>net471;netstandard2.0</TargetFrameworks>
    <DefineConstants>NET_4_0</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\Binaries\$(Configuration)\</OutputPath>
    <DocumentationFile>..\..\Binaries\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <Deterministic>true</Deterministic>
    <NoWarn>1591;419</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Erzeugt ein entsprechendes *.nupkg im Ausgabe-Verzeichnis -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Metadaten für das Package -->
    <PackageId>Komsa.Remotion.Linq.SqlBackend</PackageId>
    <Description>re-linq SQL Backend</Description>
    <PackageTags>Remotion Linq Relinq Sql</PackageTags>
    <VersionPrefix>$(RelinqPackageVersion)</VersionPrefix>
    <Authors>rubicon IT GmbH; KOMSA AG</Authors>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Damit das Package eine "Run/Output-Dependency" des Projektes wird, indem es installiert wird -->
    <DevelopmentDependency>false</DevelopmentDependency>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dateien, die ins Package kommen. Hier speziell das Assembly und die (Un)Install-Scripte -->
    <None Update="tools\*.ps1" CopyToOutputDirectory="Always" Pack="true" PackagePath="" />
    <None Include="$(OutputPath)\**\$(AssemblyName).dll" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="*.vspscc" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net471' ">
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Relinq\AssemblyInfoShared.cs">
      <Link>Properties\AssemblyInfoShared.cs</Link>
    </Compile>
    <None Include="..\Build\NuSpec\TemplateShared.nuspec">
      <Link>TemplateShared.nuspec</Link>
    </None>
    <None Include="..\LGPL.licenseheader">
      <Link>LGPL.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Relinq\Core.Net_4_5\Remotion.Linq.csproj" />
  </ItemGroup>
</Project>